{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-traffic-lights.local/contracts/validation-sequence.v1.schema.json",
  "title": "Validation Sequence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "events",
    "expected_display_states"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "status-event.v1.schema.json"
      }
    },
    "expected_display_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "display-state.v1.schema.json"
      }
    }
  }
}
