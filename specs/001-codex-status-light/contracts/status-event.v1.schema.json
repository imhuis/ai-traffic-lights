{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-traffic-lights.local/contracts/status-event.v1.schema.json",
  "title": "Codex Status Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "session_id",
    "sequence",
    "observed_at",
    "state",
    "freshness"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": "string",
      "enum": [
        "idle",
        "working",
        "waiting_for_confirmation",
        "unavailable"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "disconnected",
        "invalid"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "provider_metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 160
      }
    }
  }
}
